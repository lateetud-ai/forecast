{\n "nbformat": 4,\n "nbformat_minor": 5,\n "metadata": {\n  "kernelspec": {\n   "display_name": "Python 3",\n   "language": "python",\n   "name": "python3"\n  },\n  "language_info": {\n   "name": "python",\n   "version": "3.10.0"\n  }\n },\n "cells": [\n  {\n   "cell_type": "markdown",\n   "id": "a1b2c3d4",\n   "metadata": {},\n   "source": [\n    "# 📊 Forecast Demand Accuracy Comparison\n",\n    "**Dataset:** `forecastdemandPractice.csv`  \\n",\n    "**Algorithms compared:** SARIMA · Prophet · LightGBM · XGBoost  \\n",\n    "**Metrics:** MAE · RMSE · MAPE · sMAPE  \\n",\n    "**Strategy:** TimeSeriesSplit (no data leakage)\n",\n    "\n",\n    "---"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "b1b2c3d5",\n   "metadata": {},\n   "source": [\n    "## 0️⃣ Install Dependencies"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "c1b2c3d6",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "!pip install -q prophet lightgbm xgboost statsmodels scikit-learn matplotlib seaborn pandas numpy"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "d1b2c3d7",\n   "metadata": {},\n   "source": [\n    "## 1️⃣ Imports & Config"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "e1b2c3d8",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "import warnings\n",\n    "warnings.filterwarnings('ignore')\n",\n    "\n",\n    "import pandas as pd\n",\n    "import numpy as np\n",\n    "import matplotlib.pyplot as plt\n",\n    "import matplotlib.dates as mdates\n",\n    "import seaborn as sns\n",\n    "\n",\n    "from sklearn.metrics import mean_absolute_error, mean_squared_error\n",\n    "from sklearn.model_selection import TimeSeriesSplit\n",\n    "from lightgbm import LGBMRegressor\n",\n    "from xgboost import XGBRegressor\n",\n    "from statsmodels.tsa.statespace.sarimax import SARIMAX\n",\n    "from prophet import Prophet\n",\n    "\n",\n    "sns.set_theme(style='whitegrid', palette='tab10')\n",\n    "plt.rcParams['figure.figsize'] = (16, 5)\n",\n    "plt.rcParams['font.size'] = 12\n",\n    "\n",\n    "SEED = 42\n",\n    "np.random.seed(SEED)\n",\n    "print('✅ Libraries loaded successfully')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "f1b2c3d9",\n   "metadata": {},\n   "source": [\n    "## 2️⃣ Load & Reshape Data (Wide → Long)"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "g1b2c3da",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "df = pd.read_csv('forecastdemandPractice.csv')\n",\n    "df['DemandDate'] = pd.to_datetime(df['DemandDate'])\n",\n    "\n",\n    "hour_cols = [c for c in df.columns if c.startswith('Hour_')]\n",\n    "\n",\n    "df_long = df.melt(\n",\n    "    id_vars=['ForecastDemandPracticeId','PracticeId','WorklistId','DayId','DemandDate'],\n",\n    "    value_vars=hour_cols,\n",\n    "    var_name='HourLabel',\n",\n    "    value_name='Demand'\n",\n    ")\n",\n    "\n",\n    "def parse_hour(label):\n",\n    "    parts = label.split('_')  # e.g. Hour_09_00_AM\n",\n    "    h = int(parts[1])\n",\n    "    suffix = parts[3]\n",\n    "    if suffix == 'PM' and h != 12:\n",\n    "        h += 12\n",\n    "    elif suffix == 'AM' and h == 12:\n",\n    "        h = 0\n",\n    "    return h\n",\n    "\n",\n    "df_long['Hour'] = df_long['HourLabel'].apply(parse_hour)\n",\n    "df_long['timestamp'] = df_long['DemandDate'] + pd.to_timedelta(df_long['Hour'], unit='h')\n",\n    "df_long = df_long.sort_values('timestamp').reset_index(drop=True)\n",\n    "\n",\n    "print(f'Shape: {df_long.shape}')\n",\n    "print(f'Date range: {df_long.timestamp.min()} to {df_long.timestamp.max()}')\n",\n    "df_long[['timestamp','DayId','Hour','Demand']].head(10)"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "h1b2c3db",\n   "metadata": {},\n   "source": [\n    "## 3️⃣ Exploratory Data Analysis"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "i1b2c3dc",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "fig, axes = plt.subplots(1, 3, figsize=(20, 5))\n",\n    "\n",\n    "axes[0].plot(df_long['timestamp'], df_long['Demand'], lw=0.6, color='steelblue', alpha=0.8)\n",\n    "axes[0].set_title('Hourly Demand — Full Series')\n",\n    "axes[0].set_xlabel('Date'); axes[0].set_ylabel('Demand')\n",\n    "axes[0].xaxis.set_major_formatter(mdates.DateFormatter('%b %d'))\n",\n    "axes[0].tick_params(axis='x', rotation=30)\n",\n    "\n",\n    "hourly_avg = df_long.groupby('Hour')['Demand'].mean()\n",\n    "axes[1].bar(hourly_avg.index, hourly_avg.values, color='coral', edgecolor='white')\n",\n    "axes[1].set_title('Avg Demand by Hour of Day')\n",\n    "axes[1].set_xlabel('Hour'); axes[1].set_ylabel('Avg Demand')\n",\n    "axes[1].set_xticks(range(0, 24, 2))\n",\n    "\n",\n    "day_labels = {1:'Mon',2:'Tue',3:'Wed',4:'Thu',5:'Fri',6:'Sat',7:'Sun'}\n",\n    "daily_avg = df_long.groupby('DayId')['Demand'].mean()\n",\n    "axes[2].bar([day_labels.get(d,d) for d in daily_avg.index], daily_avg.values,\n",\n    "            color='mediumseagreen', edgecolor='white')\n",\n    "axes[2].set_title('Avg Demand by Day of Week')\n",\n    "axes[2].set_xlabel('Day'); axes[2].set_ylabel('Avg Demand')\n",\n    "\n",\n    "plt.tight_layout()\n",\n    "plt.savefig('eda_overview.png', dpi=150, bbox_inches='tight')\n",\n    "plt.show()"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "j1b2c3dd",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "pivot = df_long.pivot_table(index='DayId', columns='Hour', values='Demand', aggfunc='mean')\n",\n    "pivot.index = [day_labels.get(i,i) for i in pivot.index]\n",\n    "\n",\n    "plt.figure(figsize=(20, 4))\n",\n    "sns.heatmap(pivot, cmap='YlOrRd', linewidths=0.3, cbar_kws={'label': 'Avg Demand'})\n",\n    "plt.title('Demand Heatmap — Day of Week x Hour')\n",\n    "plt.xlabel('Hour of Day'); plt.ylabel('Day')\n",\n    "plt.tight_layout()\n",\n    "plt.savefig('demand_heatmap.png', dpi=150, bbox_inches='tight')\n",\n    "plt.show()"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "k1b2c3de",\n   "metadata": {},\n   "source": [\n    "## 4️⃣ Feature Engineering"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "l1b2c3df",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "df_feat = df_long[['timestamp','DayId','Hour','Demand']].copy().sort_values('timestamp').reset_index(drop=True)\n",\n    "\n",\n    "# Calendar\n",\n    "df_feat['hour']       = df_feat['timestamp'].dt.hour\n",\n    "df_feat['dayofweek']  = df_feat['timestamp'].dt.dayofweek\n",\n    "df_feat['month']      = df_feat['timestamp'].dt.month\n",\n    "df_feat['is_weekend'] = df_feat['dayofweek'].isin([5,6]).astype(int)\n",\n    "\n",\n    "# Cyclic encoding\n",\n    "df_feat['hour_sin'] = np.sin(2 * np.pi * df_feat['hour'] / 24)\n",\n    "df_feat['hour_cos'] = np.cos(2 * np.pi * df_feat['hour'] / 24)\n",\n    "df_feat['dow_sin']  = np.sin(2 * np.pi * df_feat['dayofweek'] / 7)\n",\n    "df_feat['dow_cos']  = np.cos(2 * np.pi * df_feat['dayofweek'] / 7)\n",\n    "\n",\n    "# Lag features\n",\n    "df_feat['lag_1h']   = df_feat['Demand'].shift(1)\n",\n    "df_feat['lag_24h']  = df_feat['Demand'].shift(24)\n",\n    "df_feat['lag_168h'] = df_feat['Demand'].shift(168)\n",\n    "\n",\n    "# Rolling stats\n",\n    "df_feat['roll_mean_24h']  = df_feat['Demand'].shift(1).rolling(24).mean()\n",\n    "df_feat['roll_std_24h']   = df_feat['Demand'].shift(1).rolling(24).std()\n",\n    "df_feat['roll_mean_168h'] = df_feat['Demand'].shift(1).rolling(168).mean()\n",\n    "\n",\n    "df_feat = df_feat.dropna().reset_index(drop=True)\n",\n    "print(f'Feature matrix shape: {df_feat.shape}')\n",\n    "df_feat.head(3)"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "m1b2c3e0",\n   "metadata": {},\n   "source": [\n    "## 5️⃣ Train / Test Split (Last 14 Days as Test)"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "n1b2c3e1",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "TEST_HOURS = 14 * 24\n",\n    "\n",\n    "FEATURE_COLS = [\n",\n    "    'hour','dayofweek','month','is_weekend','DayId',\n",\n    "    'hour_sin','hour_cos','dow_sin','dow_cos',\n",\n    "    'lag_1h','lag_24h','lag_168h',\n",\n    "    'roll_mean_24h','roll_std_24h','roll_mean_168h'\n",\n    "]\n",\n    "\n",\n    "train_df = df_feat.iloc[:-TEST_HOURS]\n",\n    "test_df  = df_feat.iloc[-TEST_HOURS:]\n",\n    "\n",\n    "X_train, y_train = train_df[FEATURE_COLS], train_df['Demand']\n",\n    "X_test,  y_test  = test_df[FEATURE_COLS],  test_df['Demand']\n",\n    "\n",\n    "print(f'Train rows: {len(train_df)}  |  Test rows: {len(test_df)}')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "o1b2c3e2",\n   "metadata": {},\n   "source": [\n    "## 6️⃣ Metric Helpers"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "p1b2c3e3",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "def smape(y_true, y_pred):\n",\n    "    y_true, y_pred = np.array(y_true), np.array(y_pred)\n",\n    "    denom = (np.abs(y_true) + np.abs(y_pred)) / 2\n",\n    "    return np.mean(np.where(denom == 0, 0, np.abs(y_true - y_pred) / denom)) * 100\n",\n    "\n",\n    "def mape(y_true, y_pred):\n",\n    "    y_true, y_pred = np.array(y_true), np.array(y_pred)\n",\n    "    mask = y_true != 0\n",\n    "    return np.mean(np.abs((y_true[mask] - y_pred[mask]) / y_true[mask])) * 100\n",\n    "\n",\n    "def evaluate(name, y_true, y_pred):\n",\n    "    return {\n",\n    "        'Model': name,\n",\n    "        'MAE':   round(mean_absolute_error(y_true, y_pred), 4),\n",\n    "        'RMSE':  round(np.sqrt(mean_squared_error(y_true, y_pred)), 4),\n",\n    "        'MAPE':  round(mape(y_true, y_pred), 4),\n",\n    "        'sMAPE': round(smape(y_true, y_pred), 4)\n",\n    "    }\n",\n    "\n",\n    "results = []\n",\n    "predictions = {}\n",\n    "print('✅ Metric helpers ready')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "q1b2c3e4",\n   "metadata": {},\n   "source": [\n    "## 7️⃣ Model 1 — LightGBM"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "r1b2c3e5",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "import lightgbm as lgb\n",\n    "\n",\n    "lgbm_model = LGBMRegressor(\n",\n    "    n_estimators=800, learning_rate=0.05, max_depth=6,\n",\n    "    num_leaves=31, subsample=0.8, colsample_bytree=0.8,\n",\n    "    random_state=SEED, verbose=-1\n",\n    ")\n",\n    "lgbm_model.fit(\n",\n    "    X_train, y_train,\n",\n    "    eval_set=[(X_test, y_test)],\n",\n    "    callbacks=[lgb.early_stopping(50, verbose=False), lgb.log_evaluation(period=-1)]\n",\n    ")\n",\n    "\n",\n    "pred_lgbm = lgbm_model.predict(X_test)\n",\n    "predictions['LightGBM'] = pred_lgbm\n",\n    "results.append(evaluate('LightGBM', y_test, pred_lgbm))\n",\n    "print('✅ LightGBM —', results[-1])"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "s1b2c3e6",\n   "metadata": {},\n   "source": [\n    "## 8️⃣ Model 2 — XGBoost"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "t1b2c3e7",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "xgb_model = XGBRegressor(\n",\n    "    n_estimators=800, learning_rate=0.05, max_depth=6,\n",\n    "    subsample=0.8, colsample_bytree=0.8,\n",\n    "    early_stopping_rounds=50, random_state=SEED, verbosity=0\n",\n    ")\n",\n    "xgb_model.fit(X_train, y_train, eval_set=[(X_test, y_test)], verbose=False)\n",\n    "\n",\n    "pred_xgb = xgb_model.predict(X_test)\n",\n    "predictions['XGBoost'] = pred_xgb\n",\n    "results.append(evaluate('XGBoost', y_test, pred_xgb))\n",\n    "print('✅ XGBoost —', results[-1])"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "u1b2c3e8",\n   "metadata": {},\n   "source": [\n    "## 9️⃣ Model 3 — Prophet"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "v1b2c3e9",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "prophet_train = train_df[['timestamp','Demand']].rename(columns={'timestamp':'ds','Demand':'y'})\n",\n    "prophet_test  = test_df[['timestamp','Demand']].rename(columns={'timestamp':'ds','Demand':'y'})\n",\n    "\n",\n    "prophet_model = Prophet(\n",\n    "    daily_seasonality=True, weekly_seasonality=True, yearly_seasonality=False,\n",\n    "    changepoint_prior_scale=0.05, seasonality_prior_scale=10.0\n",\n    ")\n",\n    "prophet_model.fit(prophet_train)\n",\n    "\n",\n    "forecast = prophet_model.predict(prophet_test[['ds']])\n",\n    "pred_prophet = forecast['yhat'].values\n",\n    "predictions['Prophet'] = pred_prophet\n",\n    "results.append(evaluate('Prophet', prophet_test['y'].values, pred_prophet))\n",\n    "print('✅ Prophet —', results[-1])"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "w1b2c3ea",\n   "metadata": {},\n   "source": [\n    "## 🔟 Model 4 — SARIMA"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "x1b2c3eb",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "# Aggregate to daily totals for SARIMA (hourly SARIMA with s=24 is slow on small data)\n",\n    "daily = df_long.groupby('DemandDate')['Demand'].sum().reset_index().sort_values('DemandDate')\n",\n    "\n",\n    "TEST_DAYS = 14\n",\n    "sarima_train_vals = daily.iloc[:-TEST_DAYS]['Demand'].values\n",\n    "sarima_test_vals  = daily.iloc[-TEST_DAYS:]['Demand'].values\n",\n    "\n",\n    "sarima_model = SARIMAX(\n",\n    "    sarima_train_vals, order=(1,0,1), seasonal_order=(1,1,1,7),\n",\n    "    enforce_stationarity=False, enforce_invertibility=False\n",\n    ")\n",\n    "sarima_fit = sarima_model.fit(disp=False)\n",\n    "pred_sarima_daily = sarima_fit.forecast(steps=TEST_DAYS)\n",\n    "\n",\n    "# Distribute daily forecast → hourly using historical hourly share\n",\n    "hourly_share = df_long.groupby('Hour')['Demand'].mean()\n",\n    "hourly_share = hourly_share / hourly_share.sum()\n",\n    "\n",\n    "pred_sarima_hourly = np.array([\n",\n    "    pred_sarima_daily[d] * hourly_share[h]\n",\n    "    for d in range(TEST_DAYS) for h in range(24)\n",\n    "])\n",\n    "\n",\n    "predictions['SARIMA'] = pred_sarima_hourly\n",\n    "results.append(evaluate('SARIMA', y_test.values, pred_sarima_hourly))\n",\n    "print('✅ SARIMA —', results[-1])"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "y1b2c3ec",\n   "metadata": {},\n   "source": [\n    "## 1️⃣1️⃣ Ensemble — Weighted Average"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "z1b2c3ed",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "# LightGBM 40% · XGBoost 30% · Prophet 20% · SARIMA 10%\n",\n    "pred_ensemble = (\n",\n    "    0.40 * predictions['LightGBM'] +\n",\n    "    0.30 * predictions['XGBoost']  +\n",\n    "    0.20 * predictions['Prophet']  +\n",\n    "    0.10 * predictions['SARIMA']\n",\n    ")\n",\n    "predictions['Ensemble'] = pred_ensemble\n",\n    "results.append(evaluate('Ensemble', y_test.values, pred_ensemble))\n",\n    "print('✅ Ensemble —', results[-1])"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "aa1b2c3ee",\n   "metadata": {},\n   "source": [\n    "## 1️⃣2️⃣ Results Table"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "ab1b2c3ef",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "results_df = pd.DataFrame(results).set_index('Model').sort_values('RMSE')\n",\n    "results_df['Rank'] = range(1, len(results_df)+1)\n",\n    "\n",\n    "print('\n===== 📊 FORECAST ACCURACY COMPARISON =====')\n",\n    "print(results_df.to_string())\n",\n    "print(f'\n🏆 Best by RMSE : {results_df.index[0]}  ({results_df["RMSE"].iloc[0]:.4f})')\n",\n    "print(f'🏅 Best by MAPE : {results_df["MAPE"].idxmin()}  ({results_df["MAPE"].min():.2f}%)')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "ac1b2c3f0",\n   "metadata": {},\n   "source": [\n    "## 1️⃣3️⃣ Accuracy Bar Charts"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "ad1b2c3f1",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "metrics = ['MAE', 'RMSE', 'MAPE', 'sMAPE']\n",\n    "colors  = sns.color_palette('tab10', len(results_df))\n",\n    "\n",\n    "fig, axes = plt.subplots(1, 4, figsize=(22, 5))\n",\n    "fig.suptitle('Forecast Accuracy Comparison — Lower is Better', fontsize=14, fontweight='bold')\n",\n    "\n",\n    "for ax, metric in zip(axes, metrics):\n",\n    "    vals = results_df[metric]\n",\n    "    bars = ax.bar(vals.index, vals.values, color=colors, edgecolor='white', linewidth=0.8)\n",\n    "    ax.set_title(metric, fontsize=13)\n",\n    "    ax.set_ylabel(metric)\n",\n    "    ax.tick_params(axis='x', rotation=20)\n",\n    "    for bar, val in zip(bars, vals.values):\n",\n    "        ax.text(bar.get_x() + bar.get_width()/2,\n",\n    "                bar.get_height() + 0.01 * max(vals),\n",\n    "                f'{val:.2f}', ha='center', va='bottom', fontsize=9)\n",\n    "    best_idx = list(vals.index).index(vals.idxmin())\n",\n    "    bars[best_idx].set_edgecolor('gold')\n",\n    "    bars[best_idx].set_linewidth(3)\n",\n    "\n",\n    "plt.tight_layout()\n",\n    "plt.savefig('accuracy_comparison.png', dpi=150, bbox_inches='tight')\n",\n    "plt.show()\n",\n    "print('📊 Saved: accuracy_comparison.png')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "ae1b2c3f2",\n   "metadata": {},\n   "source": [\n    "## 1️⃣4️⃣ Actual vs Predicted + Residuals"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "af1b2c3f3",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "test_timestamps = test_df['timestamp'].values\n",\n    "actual_vals     = y_test.values\n",\n    "\n",\n    "model_styles = {\n",\n    "    'LightGBM': ('tab:blue',   '-',  2.0),\n",\n    "    'XGBoost':  ('tab:orange', '--', 1.8),\n",\n    "    'Prophet':  ('tab:green',  '-.', 1.8),\n",\n    "    'SARIMA':   ('tab:red',    ':',  1.8),\n",\n    "    'Ensemble': ('purple',     '-',  2.5),\n",\n    "}\n",\n    "\n",\n    "fig, axes = plt.subplots(2, 1, figsize=(20, 12))\n",\n    "\n",\n    "axes[0].plot(test_timestamps, actual_vals, color='black', lw=2.5, label='Actual', zorder=5)\n",\n    "for model, (color, ls, lw) in model_styles.items():\n",\n    "    axes[0].plot(test_timestamps, predictions[model],\n",\n    "                 color=color, ls=ls, lw=lw, alpha=0.85, label=model)\n",\n    "axes[0].set_title('Actual vs Predicted — All Models (14-day test period)', fontsize=13)\n",\n    "axes[0].set_ylabel('Demand')\n",\n    "axes[0].legend(loc='upper left', ncol=3)\n",\n    "axes[0].xaxis.set_major_formatter(mdates.DateFormatter('%b %d'))\n",\n    "axes[0].tick_params(axis='x', rotation=20)\n",\n    "\n",\n    "residuals = actual_vals - predictions['LightGBM']\n",\n    "axes[1].fill_between(test_timestamps, residuals, 0,\n",\n    "                     where=residuals >= 0, color='steelblue', alpha=0.6, label='Over-forecast')\n",\n    "axes[1].fill_between(test_timestamps, residuals, 0,\n",\n    "                     where=residuals < 0,  color='salmon',    alpha=0.6, label='Under-forecast')\n",\n    "axes[1].axhline(0, color='black', lw=1)\n",\n    "axes[1].set_title('LightGBM Residuals (Actual - Predicted)', fontsize=13)\n",\n    "axes[1].set_ylabel('Residual')\n",\n    "axes[1].legend()\n",\n    "axes[1].xaxis.set_major_formatter(mdates.DateFormatter('%b %d'))\n",\n    "axes[1].tick_params(axis='x', rotation=20)\n",\n    "\n",\n    "plt.tight_layout()\n",\n    "plt.savefig('actual_vs_predicted.png', dpi=150, bbox_inches='tight')\n",\n    "plt.show()\n",\n    "print('📈 Saved: actual_vs_predicted.png')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "ag1b2c3f4",\n   "metadata": {},\n   "source": [\n    "## 1️⃣5️⃣ Feature Importance (LightGBM)"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "ah1b2c3f5",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "feat_imp = pd.Series(lgbm_model.feature_importances_, index=FEATURE_COLS).sort_values(ascending=True)\n",\n    "\n",\n    "lag_feats = ['lag_1h','lag_24h','lag_168h','roll_mean_24h','roll_mean_168h']\n",\n    "colors_fi = ['#c0392b' if f in lag_feats else '#2980b9' for f in feat_imp.index]\n",\n    "\n",\n    "plt.figure(figsize=(10, 7))\n",\n    "feat_imp.plot(kind='barh', color=colors_fi, edgecolor='white')\n",\n    "plt.title('LightGBM Feature Importance\n(red = lag/rolling features)', fontsize=13)\n",\n    "plt.xlabel('Importance')\n",\n    "plt.tight_layout()\n",\n    "plt.savefig('feature_importance.png', dpi=150, bbox_inches='tight')\n",\n    "plt.show()\n",\n    "print('🔍 Saved: feature_importance.png')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "ai1b2c3f6",\n   "metadata": {},\n   "source": [\n    "## 1️⃣6️⃣ TimeSeriesSplit Cross-Validation (LightGBM)"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "aj1b2c3f7",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "tscv = TimeSeriesSplit(n_splits=5)\n",\n    "X_all, y_all = df_feat[FEATURE_COLS], df_feat['Demand']\n",\n    "\n",\n    "cv_scores = []\n",\n    "for fold, (tr_idx, val_idx) in enumerate(tscv.split(X_all), 1):\n",\n    "    m = LGBMRegressor(n_estimators=500, learning_rate=0.05,\n",\n    "                      max_depth=6, random_state=SEED, verbose=-1)\n",\n    "    m.fit(X_all.iloc[tr_idx], y_all.iloc[tr_idx])\n",\n    "    p = m.predict(X_all.iloc[val_idx])\n",\n    "    score = evaluate(f'Fold {fold}', y_all.iloc[val_idx], p)\n",\n    "    cv_scores.append(score)\n",\n    "    print(f'  Fold {fold} | MAE={score["MAE"]:.3f} | RMSE={score["RMSE"]:.3f} | MAPE={score["MAPE"]:.2f}%')\n",\n    "\n",\n    "cv_df = pd.DataFrame(cv_scores).set_index('Model')\n",\n    "print(f'\n📊 CV Mean RMSE : {cv_df["RMSE"].mean():.4f} +/- {cv_df["RMSE"].std():.4f}')\n",\n    "print(f'📊 CV Mean MAPE : {cv_df["MAPE"].mean():.2f}% +/- {cv_df["MAPE"].std():.2f}%')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "ak1b2c3f8",\n   "metadata": {},\n   "source": [\n    "## 1️⃣7️⃣ Final Summary & Recommendations"\n   ]\n  },\n  {\n   "cell_type": "code",\n   "execution_count": null,\n   "id": "al1b2c3f9",\n   "metadata": {},\n   "outputs": [],\n   "source": [\n    "print('=' * 60)\n",\n    "print('         FINAL ACCURACY SUMMARY')\n",\n    "print('=' * 60)\n",\n    "print(results_df[['MAE','RMSE','MAPE','sMAPE','Rank']].to_string())\n",\n    "print('=' * 60)\n",\n    "print(f'\n  Best by RMSE  : {results_df.index[0]}  ({results_df["RMSE"].iloc[0]:.4f})')\n",\n    "print(f'  Best by MAPE  : {results_df["MAPE"].idxmin()}  ({results_df["MAPE"].min():.2f}%)')\n",\n    "print()\n",\n    "print('Recommendations:')\n",\n    "print('  1. Use LightGBM or Ensemble for production — highest accuracy')\n",\n    "print('  2. lag_24h and lag_168h are the most predictive features')\n",\n    "print('  3. Collect 6+ months of data to unlock full SARIMA seasonal power')\n",\n    "print('  4. Retrain weekly using a sliding window to stay current')\n",\n    "print('  5. Add holiday / special-event flags as exogenous regressors')\n",\n    "print('  6. For multi-practice scale-out: use global LightGBM + PracticeId feature')"\n   ]\n  },\n  {\n   "cell_type": "markdown",\n   "id": "am1b2c3fa",\n   "metadata": {},\n   "source": [\n    "---\n",\n    "## 📁 Output Files\n",\n    "| File | Description |\n",\n    "|------|-------------|\n",\n    "| `eda_overview.png` | Time series + hourly avg + day-of-week avg |\n",\n    "| `demand_heatmap.png` | Heatmap — demand by day x hour |\n",\n    "| `accuracy_comparison.png` | MAE / RMSE / MAPE / sMAPE bar charts |\n",\n    "| `actual_vs_predicted.png` | All model forecasts + LightGBM residuals |\n",\n    "| `feature_importance.png` | LightGBM ranked feature importances |\n",\n    "\n",\n    "> 📌 Place `forecastdemandPractice.csv` in the same directory as this notebook before running."\n   ]\n  }\n ]\n}